# Database
DATABASE_URL=postgresql://autoroba:autoroba_secret@localhost:5432/autoroba_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-a-very-strong-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# App
NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# MinIO / Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=autoroba_minio
MINIO_SECRET_KEY=autoroba_minio_secret
MINIO_BUCKET=autoroba-files

# Encryption (for NPWP/NIK column encryption)
FIELD_ENCRYPTION_KEY=change-me-32-bytes-hex-encoded-key

# Optional: Coretax (DJP) integration
# CORETAX_API_URL=
# CORETAX_CLIENT_ID=
# CORETAX_CLIENT_SECRET=
